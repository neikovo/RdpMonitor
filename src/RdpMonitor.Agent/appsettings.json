{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Agent": {
    "ServerUrl": "https://CHANGE-ME-server-address:5443",
    "EnrollmentToken": "CHANGE-ME-enrollment-token",
    "HeartbeatIntervalSeconds": 60,
    "QueueFlushIntervalSeconds": 15,
    "AllowInsecureTls": false
  },
  "Audit": {
    "FileFolders": [],
    "IgnoreFilePatterns": [ "~$*", "*.tmp", "*.temp", "Thumbs.db", "desktop.ini" ],
    "MonitorProcesses": true,
    "SuspiciousProcesses": [
      "mimikatz", "procdump", "psexec", "psexesvc", "nc", "ncat", "netcat", "nmap", "masscan",
      "pwdump", "lazagne", "rubeus", "sharphound", "bloodhound", "hydra", "hashcat", "fgdump", "wce"
    ],
    "SuspiciousCommandLinePatterns": [
      "-enc(odedcommand)?\\s",
      "invoke-mimikatz",
      "downloadstring|downloadfile|frombase64string",
      "vssadmin(\\.exe)?\\s+delete\\s+shadows",
      "wbadmin(\\.exe)?\\s+delete",
      "bcdedit.*recoveryenabled\\s+no",
      "net1?\\s+user\\s+.*\\s/add",
      "net1?\\s+localgroup\\s+administrators\\s+.*\\s/add",
      "reg(\\.exe)?\\s+save\\s+hklm\\\\(sam|security|system)",
      "ntdsutil",
      "sekurlsa|lsadump",
      "procdump.*lsass"
    ],
    "DedupSeconds": 10,
    "MaxEventsPerMinute": 120
  }
}

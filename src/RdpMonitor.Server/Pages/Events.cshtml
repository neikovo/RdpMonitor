@page
@model RdpMonitor.Server.Pages.EventsModel
@using RdpMonitor.Shared
@{
    ViewData["Title"] = "Events";
}

<h2 class="mb-3">Events</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="minSeverity" class="form-select" onchange="this.form.submit()">
            <option value="">All priorities</option>
            @foreach (var sev in Enum.GetValues<AlertSeverity>())
            {
                <option value="@((int)sev)" selected="@(Model.MinSeverity == sev)">@sev and above</option>
            }
        </select>
    </div>
    @if (Model.AgentId.HasValue)
    {
        <input type="hidden" name="agentId" value="@Model.AgentId" />
        <div class="col-auto align-self-center">
            <a href="/Events">(clear the agent filter)</a>
        </div>
    }
</form>

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th>Time</th>
            <th>Agent</th>
            <th>Type</th>
            <th>Priority</th>
            <th>User</th>
            <th>Source IP</th>
            <th>Details</th>
            <th>E-mail sent</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model.Events)
        {
            <tr>
                <td>@e.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td><a href="/Events?agentId=@e.AgentId">@(Model.AgentNames.GetValueOrDefault(e.AgentId, e.AgentId.ToString()))</a></td>
                <td>@e.EventType</td>
                <td>
                    @{
                        var badgeClass = e.Severity switch
                        {
                            AlertSeverity.Critical => "bg-danger",
                            AlertSeverity.High => "bg-danger",
                            AlertSeverity.Medium => "bg-warning text-dark",
                            AlertSeverity.Low => "bg-secondary",
                            _ => "bg-light text-dark"
                        };
                    }
                    <span class="badge @badgeClass">@e.Severity</span>
                </td>
                <td>@e.Username</td>
                <td>@e.SourceIp</td>
                <td class="small text-break" style="max-width: 520px; white-space: pre-line;">@e.Details</td>
                <td>@(e.EmailSent ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Events.Count == 0)
{
    <div class="alert alert-info">No events to show.</div>
}

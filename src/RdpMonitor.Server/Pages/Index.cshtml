@page
@model RdpMonitor.Server.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-3">Installed agents</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success py-2">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger py-2">@Model.Error</div>
}

@if (Model.Agents.Count == 0)
{
    <div class="alert alert-info">No agents registered yet. Install an agent on a server and it will appear here automatically.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Status</th>
                <th>Host</th>
                <th>IP address</th>
                <th>OS</th>
                <th>Last seen</th>
                <th>Events (24h)</th>
                <th>High priority (24h)</th>
                <th>Muted</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Agents)
            {
                <tr>
                    <td>
                        @if (a.IsOnline)
                        {
                            <span class="badge bg-success">Online</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Offline</span>
                        }
                    </td>
                    <td>@a.Hostname</td>
                    <td>@a.IpAddress</td>
                    <td class="text-muted small">@a.OsVersion</td>
                    <td>@a.LastSeenAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@a.EventCount24h</td>
                    <td>
                        @if (a.HighSeverityCount24h > 0)
                        {
                            <span class="badge bg-danger">@a.HighSeverityCount24h</span>
                        }
                        else
                        {
                            <span>0</span>
                        }
                    </td>
                    <td>@(a.IsMuted ? "Yes" : "No")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/Events?agentId=@a.Id">Events</a>
                        <form method="post" asp-page-handler="ToggleMute" asp-route-id="@a.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning">@(a.IsMuted ? "Unmute" : "Mute")</button>
                        </form>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#clearEventsModal"
                                data-agent-id="@a.Id" data-agent-name="@a.Hostname">Delete events</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="modal fade" id="clearEventsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="ClearEvents" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete events</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>All stored events</strong> of agent <strong id="clearEventsName"></strong> will be deleted. The agent stays registered and keeps working. This cannot be undone.</p>
                <input type="hidden" name="id" id="clearEventsId" />
                <label class="form-label">Enter your dashboard password</label>
                <input type="password" name="password" class="form-control" autocomplete="current-password" required />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete the events</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('clearEventsModal').addEventListener('show.bs.modal', function (ev) {
            var b = ev.relatedTarget;
            document.getElementById('clearEventsId').value = b.getAttribute('data-agent-id');
            document.getElementById('clearEventsName').textContent = b.getAttribute('data-agent-name');
            this.querySelector('input[type=password]').value = '';
        });
    </script>
}

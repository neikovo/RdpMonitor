@page
@model RdpMonitor.Server.Pages.SettingsModel
@using RdpMonitor.Shared
@{
    ViewData["Title"] = "Settings";
}

<h2 class="mb-3">Settings</h2>

<h4>Alert priority by event type</h4>
<p class="text-muted">Here you set the priority of each event type and whether it sends an e-mail. An event sends an e-mail only if it is enabled here <em>and</em> its priority is equal to or above the global threshold (see appsettings.json → Alerts:MinSeverityToEmail).</p>
<table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>Event type</th>
            <th>Priority</th>
            <th>Sends e-mail</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.TypeSettings)
        {
            <tr>
                <form method="post" asp-page-handler="UpdateType">
                    <td>
                        @s.EventType
                        <input type="hidden" name="eventType" value="@s.EventType" />
                    </td>
                    <td>
                        <select name="severity" class="form-select form-select-sm">
                            @foreach (var sev in Enum.GetValues<AlertSeverity>())
                            {
                                <option value="@sev" selected="@(sev == s.Severity)">@sev</option>
                            }
                        </select>
                    </td>
                    <td>
                        <input type="checkbox" class="form-check-input" name="emailEnabled" value="true" checked="@s.EmailEnabled" />
                    </td>
                    <td>
                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                    </td>
                </form>
            </tr>
        }
    </tbody>
</table>

<h4 class="mt-4">E-mail alert recipients</h4>
<table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>E-mail</th>
            <th>Name</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Recipients)
        {
            <tr>
                <td>@r.Email</td>
                <td>@r.DisplayName</td>
                <td>@(r.Enabled ? "Yes" : "No")</td>
                <td>
                    <form method="post" asp-page-handler="ToggleRecipient" asp-route-id="@r.Id" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-warning">@(r.Enabled ? "Deactivate" : "Activate")</button>
                    </form>
                    <form method="post" asp-page-handler="DeleteRecipient" asp-route-id="@r.Id" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<form method="post" asp-page-handler="AddRecipient" class="row g-2">
    <div class="col-auto">
        <input asp-for="NewRecipientEmail" class="form-control" placeholder="name@company.com" />
    </div>
    <div class="col-auto">
        <input asp-for="NewRecipientName" class="form-control" placeholder="Name (optional)" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Add recipient</button>
    </div>
</form>
